# =============================================================================
# Dilbaz — root .gitignore
# Never commit: env/*.json, supabase/functions/.env, keystores, audio data,
# content/{sources,work,build}. See CLAUDE.md ("Asla commit edilmeyecekler").
# =============================================================================

# ---- Secrets and local configuration ----------------------------------------
env/
.env
.env.*
!.env.example
supabase/functions/.env
supabase/.env
*.jks
*.keystore
key.properties
local.properties
*.pem
*.p12
service-account*.json

# ---- Audio data (user recordings are never committed) -----------------------
evals/asr/audio/
*.m4a
*.wav
*.webm
*.ogg
*.opus
*.mp3
!**/test/fixtures/**/*.wav
!**/test/fixtures/**/*.m4a
!**/test/fixtures/**/*.mp3

# ---- Content pipeline (large sources, intermediate and build outputs) -------
content/sources/
content/work/
content/build/

# ---- Dart / Flutter ---------------------------------------------------------
.dart_tool/
.packages
.pub-cache/
.pub/
.flutter-plugins
.flutter-plugins-dependencies
build/
# Test coverage output at package roots (lib/src/coverage is engine code).
/coverage/
/app/coverage/
/packages/*/coverage/
lcov.info
*.g.dart
*.freezed.dart
*.mocks.dart
# drift migration helpers are generated by drift_dev make-migrations and ARE committed
!**/*.steps.dart
!**/generated/schema*.dart

# ---- Deno / Node / Supabase -------------------------------------------------
node_modules/
supabase/.branches/
supabase/.temp/
evals/results/*.tmp

# ---- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
dist/
.coverage
htmlcov/

# ---- Android / Gradle -------------------------------------------------------
.gradle/
.kotlin/
.cxx/
captures/
*.apk
*.aab

# ---- IDEs and OS ------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
.history/
.claude/settings.local.json
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
