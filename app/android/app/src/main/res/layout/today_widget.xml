<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen widget (docs/09 §9): today's cards, and Söyleyemedim. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/today_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/today_line"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:minHeight="48dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:text="@string/today_widget_open"
        android:textColor="@color/today_widget_text"
        android:textSize="15sp" />

    <Button
        android:id="@+id/capture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/today_widget_button"
        android:minHeight="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/capture_tile"
        android:textAllCaps="false"
        android:textColor="@color/today_widget_button_text"
        android:textSize="14sp" />
</LinearLayout>
