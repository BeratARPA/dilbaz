{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-web-local",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "Set-Location app; flutter run -d web-server --web-port 5173 --dart-define-from-file=env/local.json"
      ],
      "port": 5173
    },
    {
      "name": "audio-samples",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8765", "--bind", "127.0.0.1", "--directory", "content/build/audio-samples"],
      "port": 8765
    }
  ]
}
